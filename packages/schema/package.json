{
  "name": "@shapio/schema",
  "version": "0.1.0",
  "description": "Shapio model definition types, validators, diff and schema file format.",
  "license": "Apache-2.0",
  "homepage": "https://shapio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mybrokengnome/shapio.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/mybrokengnome/shapio/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@shapio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pluralize": "8.0.0",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/pluralize": "0.0.33",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
