{
  "name": "@shapio/visual",
  "version": "0.4.1",
  "description": "Visual editing for sites built on Shapio: field attributes and the preview-frame script.",
  "license": "Apache-2.0",
  "homepage": "https://shapio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mybrokengnome/shapio.git",
    "directory": "packages/visual"
  },
  "bugs": {
    "url": "https://github.com/mybrokengnome/shapio/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@shapio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global": "./dist/visual.iife.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
