{
  "name": "@shapio/local",
  "version": "0.5.4",
  "description": "Shapio's delivery API as function calls in your server process: no HTTP hop, same permissions and shapes as @shapio/client.",
  "license": "Apache-2.0",
  "homepage": "https://shapio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mybrokengnome/shapio.git",
    "directory": "packages/local"
  },
  "bugs": {
    "url": "https://github.com/mybrokengnome/shapio/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@shapio/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "@shapio/source": "./src/next.ts",
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shapio/client": "workspace:*",
    "@shapio/schema": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-presigned-post": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "mysql2": "^3.24.5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-presigned-post": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shapio/cms": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
