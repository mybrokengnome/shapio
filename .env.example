# Copy to .env for local development. Every setting is an environment variable; see apps/api/src/config/schema.ts.

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
LOG_LEVEL=info
# Pretty logs need the pino-pretty dev dependency; leave false in production.
LOG_PRETTY=true
# Origin users reach Shapio at. Required in production; every absolute URL (media, preview, OAuth
# callbacks, emails, OpenAPI) is built from it. No reverse proxy is needed.
PUBLIC_URL=http://localhost:4300
# Serve under a sub-path, e.g. /cms (default /).
BASE_PATH=/

# Database (PostgreSQL >= 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shapio_dev
DATABASE_POOL_MAX=10
MIGRATE_ON_START=true
# LISTEN/NOTIFY refreshes schema caches as soon as a model changes. Set false behind a pooler that cannot
# hold LISTEN (PgBouncer in transaction mode); every request still checks the durable schema version, so
# changes are enforced either way, only picked up on the next request instead of in the background.
SCHEMA_LISTEN=true

# Integration tests: a maintenance database on the test server. Test databases are created and dropped beside it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# HTTP. TRUST_PROXY: true, false, or the number of proxy hops (e.g. 1 behind Cloudflare or a load balancer).
TRUST_PROXY=false
# Your own sites/apps that call the API from a browser (the admin needs none). Empty disables CORS.
CORS_ORIGINS=
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# HTTPS without a proxy: your own certificate files (PEM; e.g. from certbot, your host, or a Cloudflare origin
# certificate). Set PUBLIC_URL=https://your.domain and PORT=443; HTTP_PORT=80 redirects plain HTTP to HTTPS.
# On bare metal, allow binding low ports with `sudo setcap cap_net_bind_service=+ep $(command -v node)`; with
# Docker, map the ports instead. Renewed files are picked up without a restart (checked every
# TLS_RELOAD_INTERVAL_MS).
TLS_CERT_FILE=
TLS_KEY_FILE=
# TLS_RELOAD_INTERVAL_MS=60000
# HTTP_PORT=80

# Signing secret (preview links, private-media URLs, app-user tokens, encryption of stored webhook and deploy
# secrets). Optional: when unset, Shapio generates one on first boot and stores it in the database. Set it (at
# least 32 characters) to share one secret across environments. Changing it signs app users out.
SESSION_SECRET=

# First-run setup. Default false: whoever opens /admin/ first while no admin exists creates the owner.
# true: Setup also needs the one-time token logged at boot (for installs exposed before setup).
SETUP_REQUIRE_TOKEN=false

# Jobs: inline runs the worker inside the API process; dedicated means a separate `shapio worker` process.
WORKER_MODE=inline
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_MS=60000
# A daily job (system.retention) deletes succeeded jobs, dispatched outbox events and after-hook run records
# older than this many days. Dead jobs and undispatched events are always kept for an operator.
RETENTION_DAYS=30
# Days after which an untouched draft or unpublished changes appear in the Inbox.
# HEALTH_STALE_DAYS=14

# Media storage: local (files under MEDIA_PATH) or s3 (any S3-compatible service).
STORAGE_DRIVER=local
MEDIA_PATH=./media
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=false
# Cloudflare R2 example: STORAGE_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, STORAGE_S3_REGION=auto.
# Most self-hosted services (versitygw, Garage, SeaweedFS) need STORAGE_S3_FORCE_PATH_STYLE=true. Browsers upload straight to the
# bucket, so its CORS rules must allow POST from PUBLIC_URL's origin.
# `shapio media migrate --from local --to s3` (and back) moves existing media; the S3 settings may be set with
# either driver. Objects are stored under public/ and private/ prefixes: expose only public/ to the world.
# Base URL public media is served from (CDN or public bucket domain); unset = Shapio serves it.
# MEDIA_PUBLIC_BASE_URL=
# Upload limits: largest file in bytes, and allowed types (checked against the file's bytes, not its name).
# MEDIA_MAX_UPLOAD_BYTES=104857600
# MEDIA_ALLOWED_TYPES=image/*,video/*,audio/*,application/pdf,text/plain,text/csv,application/json
# Requests per minute and IP for public media files served by Shapio (signed URLs use RATE_LIMIT_MAX).
# MEDIA_RATE_LIMIT_MAX=6000

# Outgoing email (invitations, password resets). `console` writes messages to the log instead of sending
# them: fine for development, set up SMTP for production.
EMAIL_TRANSPORT=console
# EMAIL_FROM=Shapio <cms@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# App users: the end users of your sites and apps (/api/app-auth). Email links point at pages on your site,
# which read the token from the URL fragment and POST it back. Provider callbacks:
# {PUBLIC_URL}{BASE_PATH}/api/app-auth/oauth/<google|github>/callback.
# Where OAuth may return users (comma-separated exact origins, or custom-scheme prefixes for native apps).
# Unset: the origins in CORS_ORIGINS plus PUBLIC_URL's.
# APP_AUTH_RETURN_URLS=https://www.example.com,myapp://auth
# APP_AUTH_REQUIRE_EMAIL_CONFIRMATION=false
# APP_AUTH_CONFIRM_EMAIL_URL=https://www.example.com/confirm-email
# APP_AUTH_RESET_PASSWORD_URL=https://www.example.com/reset-password
# APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# APP_AUTH_REFRESH_TOKEN_TTL_DAYS=30
# APP_AUTH_GOOGLE_CLIENT_ID=
# APP_AUTH_GOOGLE_CLIENT_SECRET=
# APP_AUTH_GITHUB_CLIENT_ID=
# APP_AUTH_GITHUB_CLIENT_SECRET=

# Publishing: webhooks and deployment connections.
# Webhooks and deploy hooks never reach private, loopback or link-local addresses unless the address is in
# this comma-separated CIDR list AND the webhook/connection turns on "allow private network".
# OUTBOUND_PRIVATE_NETWORK_ALLOWLIST=10.0.0.0/8,192.168.1.20/32
# OUTBOUND_TIMEOUT_MS=10000
# Provider APIs (change only for GitHub Enterprise Server or a test double).
# CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
# GITHUB_API_URL=https://api.github.com
# VERCEL_API_URL=https://api.vercel.com
# NETLIFY_API_URL=https://api.netlify.com
# A deployment connection's secret may be entered as ${ENV:VARIABLE_NAME} instead of its value: Shapio then
# stores only the variable name and reads the value from this environment each time it is used (set it for
# the API and for a dedicated worker). Only variables starting with SHAPIO_SECRET_ qualify, plus the names or
# PREFIX* patterns in SECRET_ENV_ALLOWLIST, so a connection can never read Shapio's own settings.
# For example, enter ${ENV:SHAPIO_SECRET_CF_PAGES_TOKEN} and set:
# SHAPIO_SECRET_CF_PAGES_TOKEN=
# SECRET_ENV_ALLOWLIST=CF_PAGES_*

# GraphQL at /api/graphql (same permissions, filters and page sizes as REST).
# GRAPHQL_ENABLED=true
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_MAX_COMPLEXITY=20000
# GraphiQL for admins at /api/graphql/playground (self-hosted, no CDN).
# GRAPHQL_PLAYGROUND_ENABLED=true
# Let anonymous callers and app users introspect the schema (admins and API tokens always can).
# GRAPHQL_PUBLIC_INTROSPECTION=false

# Project extensions (hooks, custom routes/services, editors, jobs): path to shapio.config.{ts,mts,js,mjs}.
# Default: the working directory is searched; none means no extensions. Changing extensions needs a restart.
# SHAPIO_CONFIG_PATH=./shapio.config.ts

# Field usage from delivery traffic: counts which fields each token reads (counts only, never payloads; the
# data stays in this database). Shown in the admin and in change-set reviews.
# USAGE_TRACKING=true
# USAGE_RETENTION_DAYS=90
# USAGE_FLUSH_INTERVAL_MS=30000

# Assist (alt text, summaries, translation, rewrites, schema drafts, content-ops) with your own model
# provider. Off unless AI_PROVIDER is set; nothing is sent anywhere while it is off. See documentation/assist.md.
# anthropic | openai | openai-compatible (Ollama, LM Studio, vLLM)
# AI_PROVIDER=anthropic
# AI_MODEL=
# AI_API_KEY=
# For openai-compatible (required), or to point the others at a proxy. Ollama:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MAX_TOKENS=8192
# AI_TIMEOUT_MS=60000
# Assist requests per minute and admin (or admin API token).
# AI_RATE_LIMIT_MAX=20
