{
  "name": "example-site",
  "version": "0.1.0",
  "private": true,
  "description": "A static Astro site built from Shapio content: pinned snapshot, EN + FR, preview, signed build callbacks.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:stop": "ASTRO_TELEMETRY_DISABLED=1 astro preview stop",
    "seed": "node --env-file-if-exists=.env --conditions=@shapio/source --import tsx scripts/seed.ts",
    "smoke": "node --env-file-if-exists=.env --conditions=@shapio/source --import tsx scripts/smoke.ts",
    "report-status": "node --env-file-if-exists=.env --import tsx scripts/reportStatus.ts",
    "build:incremental": "node --env-file-if-exists=.env --conditions=@shapio/source --import tsx scripts/incrementalBuild.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shapio/client": "workspace:*",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@shapio/cli": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
