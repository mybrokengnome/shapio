"""
A rich-text document: the versioned JSON document and its sanitized HTML rendering.
"""
type RichText {
  """\`{ format, version, doc }\` (ProseMirror JSON)"""
  json: JSON!
  html: String!
}

"""Any JSON value (JSON fields and rich-text documents)."""
scalar JSON

"""An integer between -(2^53 - 1) and 2^53 - 1, as a JSON number."""
scalar Int53

enum PageToneEnum {
  """Calm"""
  calm
}

enum PageTagsEnum {
  """A"""
  a
}

"""
A media asset. Private assets carry signed URLs that expire at \`urlExpiresAt\`.
"""
type Media {
  id: ID!
  filename: String!
  mimeType: String!
  sizeBytes: Float!
  width: Int
  height: Int
  alt: String!
  caption: String!
  focalPoint: FocalPoint
  url: String!
  urlExpiresAt: String
  variants: [MediaVariant!]!
}

"""
Where the subject of an image is, as fractions of its width and height (0 to 1).
"""
type FocalPoint {
  x: Float!
  y: Float!
}

"""A ready image variant (thumbnail, responsive width, converted format)."""
type MediaVariant {
  name: String!
  width: Int
  height: Int
  format: String
  mimeType: String!
  url: String!
}

"""Hero"""
type Hero {
  """Heading"""
  heading: String

  """Image"""
  image: Media
}

"""Quote"""
type Quote {
  """Text"""
  text: String
}

union PageSectionsZone = Hero | Quote

