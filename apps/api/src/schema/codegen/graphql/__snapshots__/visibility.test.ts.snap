""""Article"""
type Article {
  id: ID!

  """The locale that served this entry (fallback aware)"""
  locale: String!
  createdAt: String!
  updatedAt: String!
  publishedAt: String

  """
  This entry in its other locales, read the same way (published or draft)
  """
  localizations: [Article!]

  """Title"""
  title: String

  """Teaser"""
  teaser: Card

  """Sections"""
  sections: [ArticleSectionsZone!]
}

"""Card"""
type Card {
  """Heading"""
  heading: String
}

union ArticleSectionsZone = Card

type Query {
  """One Article entry by ID (null when not found)"""
  article(
    id: ID!

    """Locale code; the default locale when omitted"""
    locale: String

    """
    Serve the locale's fallback when an entry has no version in the requested locale
    """
    fallback: Boolean = true

    """
    DRAFT needs an admin user, an admin API token or a delivery token granted Read drafts
    """
    publicationState: PublicationState = PUBLISHED

    """Read published content as of this publication sequence"""
    snapshot: Int
  ): Article

  """A page of Article entries"""
  articles(
    filter: ArticleFilter
    sort: [ArticleSort!]

    """Case-insensitive search of the model's title field"""
    search: String
    page: Int
    pageSize: Int

    """Locale code; the default locale when omitted"""
    locale: String

    """
    Serve the locale's fallback when an entry has no version in the requested locale
    """
    fallback: Boolean = true

    """
    DRAFT needs an admin user, an admin API token or a delivery token granted Read drafts
    """
    publicationState: PublicationState = PUBLISHED

    """Read published content as of this publication sequence"""
    snapshot: Int
  ): ArticleConnection

  """
  The schema version this API reflects; it changes whenever a model changes
  """
  _schemaVersion: Int!

  """
  Entries whose live content changed between two snapshots (incremental builds)
  """
  _changes(
    from: Int!

    """Defaults to the current snapshot"""
    to: Int

    """\`nextCursor\` of the previous page"""
    after: ID

    """Entries per page (default 100, at most 500)"""
    first: Int
  ): SnapshotChangePage!

  """The current snapshot and schema version"""
  _snapshot: SnapshotInfo!

  """The request's site: its key, name and SEO defaults"""
  _site: SiteInfo!
}

"""
DRAFT is for admin principals and delivery tokens granted Read drafts (development servers).
"""
enum PublicationState {
  PUBLISHED
  DRAFT
}

type ArticleConnection {
  nodes: [Article!]!
  totalCount: Int!
  pageInfo: PageInfo!

  """The requested locale"""
  locale: String!

  """
  Publication sequence this page reflects (pin a site build with \`snapshot\`); null for drafts
  """
  snapshot: Int
}

type PageInfo {
  page: Int!
  pageSize: Int!
  pageCount: Int!
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
}

"""Conditions on Article entries; every key given must hold (AND)."""
input ArticleFilter {
  id: IDFilter
  createdAt: DateTimeFilter
  updatedAt: DateTimeFilter

  """Title"""
  title: StringFilter

  """Writer"""
  writer: IDFilter

  """All must hold"""
  and: [ArticleFilter!]

  """At least one must hold"""
  or: [ArticleFilter!]

  """Must not hold"""
  not: ArticleFilter
}

"""
Conditions on one ID value, ANDed. The same operators as the REST API's filters.
"""
input IDFilter {
  """Equals (on list fields: contains)"""
  eq: ID

  """Does not equal"""
  ne: ID

  """Equals one of"""
  in: [ID!]

  """Equals none of"""
  nin: [ID!]

  """true: has no value; false: has a value"""
  null: Boolean

  """true: has a value; false: has no value"""
  notNull: Boolean
}

"""
Conditions on one DateTime value, ANDed. The same operators as the REST API's filters.
"""
input DateTimeFilter {
  """Equals (on list fields: contains)"""
  eq: String

  """Does not equal"""
  ne: String

  """Equals one of"""
  in: [String!]

  """Equals none of"""
  nin: [String!]

  """true: has no value; false: has a value"""
  null: Boolean

  """true: has a value; false: has no value"""
  notNull: Boolean

  """Less than (needs filterable or sortable)"""
  lt: String

  """Less than or equal (needs filterable or sortable)"""
  lte: String

  """Greater than (needs filterable or sortable)"""
  gt: String

  """Greater than or equal (needs filterable or sortable)"""
  gte: String
}

"""
Conditions on one String value, ANDed. The same operators as the REST API's filters.
"""
input StringFilter {
  """Equals (on list fields: contains)"""
  eq: String

  """Does not equal"""
  ne: String

  """Equals one of"""
  in: [String!]

  """Equals none of"""
  nin: [String!]

  """true: has no value; false: has a value"""
  null: Boolean

  """true: has a value; false: has no value"""
  notNull: Boolean

  """Less than (needs filterable or sortable)"""
  lt: String

  """Less than or equal (needs filterable or sortable)"""
  lte: String

  """Greater than (needs filterable or sortable)"""
  gt: String

  """Greater than or equal (needs filterable or sortable)"""
  gte: String

  """Contains, case-sensitive (needs filterable)"""
  contains: String

  """Does not contain, case-sensitive (needs filterable)"""
  notContains: String

  """Contains, case-insensitive (needs filterable)"""
  containsi: String

  """Starts with (needs filterable)"""
  startsWith: String

  """Ends with (needs filterable)"""
  endsWith: String
}

"""One sort key of Article entries (set exactly one field per item)."""
input ArticleSort {
  id: SortDirection
  createdAt: SortDirection
  updatedAt: SortDirection
  title: SortDirection
}

enum SortDirection {
  ASC
  DESC
}

type SnapshotChangePage {
  from: Int!
  to: Int!
  fromSchemaVersion: Int
  toSchemaVersion: Int
  nodes: [SnapshotChange!]!

  """Pass as \`after\` for the next page; null on the last page"""
  nextCursor: ID
}

"""
An entry whose live content differs between two snapshots, with the locales that changed
"""
type SnapshotChange {
  id: ID!
  modelId: ID!

  """The model's API ID"""
  modelKey: String!

  """The REST route key (\`/api/content/<routeKey>\`)"""
  routeKey: String!
  locales: [SnapshotChangeLocale!]!
}

type SnapshotChangeLocale {
  locale: String!
  change: SnapshotChangeKind!
}

enum SnapshotChangeKind {
  """Not live at \`from\`, live at \`to\`"""
  PUBLISHED

  """Live at both ends with different content"""
  UPDATED

  """Live at \`from\`, not live (or deleted) at \`to\`"""
  UNPUBLISHED
}

type SnapshotInfo {
  """The latest publication sequence number"""
  snapshot: Int!

  """The active schema version"""
  schemaVersion: Int!
  publishedAt: String
}

"""The site this request reads, and its SEO defaults"""
type SiteInfo {
  key: String!
  name: String!
  seo: SiteSeoDefaults!
}

type SiteSeoDefaults {
  locales: [SiteSeoLocale!]!
  twitterHandle: String

  """The default social image (a public image), or null"""
  image: Media
}

"""
One locale's default SEO texts; a missing one falls back along the locale chain
"""
type SiteSeoLocale {
  locale: String!
  siteName: String

  """
  Page titles go through it: \`%s\` is replaced by the title, e.g. \`%s · Acme\`
  """
  titleTemplate: String

  """Used where an entry has no SEO description"""
  description: String
}

"""
A media asset. Private assets carry signed URLs that expire at \`urlExpiresAt\`.
"""
type Media {
  id: ID!
  filename: String!
  mimeType: String!
  sizeBytes: Float!
  width: Int
  height: Int
  alt: String!
  caption: String!
  focalPoint: FocalPoint
  url: String!
  urlExpiresAt: String
  variants: [MediaVariant!]!
}

"""
Where the subject of an image is, as fractions of its width and height (0 to 1).
"""
type FocalPoint {
  x: Float!
  y: Float!
}

"""A ready image variant (thumbnail, responsive width, converted format)."""
type MediaVariant {
  name: String!
  width: Int
  height: Int
  format: String
  mimeType: String!
  url: String!
}

type Mutation {
  """Creates a Article entry (a draft unless \`publish\` is true)"""
  createArticle(locale: String, publish: Boolean): Entry

  """
  Changes the given fields of the draft (a patch: omitted fields keep their values)
  """
  updateArticle(id: ID!, locale: String, expectedVersion: Int): Entry
  deleteArticle(id: ID!): ID!

  """
  Publishes the given locales (default: the default locale); with \`expectedVersion\`, only if that one locale's draft is still at it
  """
  publishArticle(id: ID!, locales: [String!], expectedVersion: Int): Entry

  """Unpublishes the given locales (default: the default locale)"""
  unpublishArticle(id: ID!, locales: [String!]): Entry

  """Creates a Submission entry (a draft unless \`publish\` is true)"""
  createSubmission(data: SubmissionInput, locale: String, publish: Boolean): Entry

  """
  Changes the given fields of the draft (a patch: omitted fields keep their values)
  """
  updateSubmission(id: ID!, data: SubmissionInput, locale: String, expectedVersion: Int): Entry
  deleteSubmission(id: ID!): ID!

  """
  Publishes the given locales (default: the default locale); with \`expectedVersion\`, only if that one locale's draft is still at it
  """
  publishSubmission(id: ID!, locales: [String!], expectedVersion: Int): Entry

  """Unpublishes the given locales (default: the default locale)"""
  unpublishSubmission(id: ID!, locales: [String!]): Entry
}

type Entry {
  id: ID!
  locale: String!
  version: Int!

  """draft, published or modified"""
  status: String!
  createdAt: String!
  updatedAt: String!
  publishedAt: String
}

input SubmissionInput {
  """Email"""
  email: String
}"
