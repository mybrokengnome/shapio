exports[`interfaces: TypeScript and OpenAPI > generates TypeScript with the contract, its members’ union and any entry 1`] = `
"// Generated by \`shapio types generate\`. Do not edit: regenerate after changing models.

export type RichTextNode = {
  type: string;
  attrs?: Record<string, unknown>;
  content?: RichTextNode[];
  text?: string;
  marks?: Array<{ type: string; attrs?: Record<string, unknown> }>;
};

export type RichText = { format: 'shapio-richtext'; version: 1; doc: RichTextNode };

/**
 * Rich text as delivery returns it, per the request's \`richText\`: \`doc\` with \`json\` (the default), sanitized
 * \`html\` rendered from the document with \`html\`, both with \`both\`.
 */
export type RichTextOutput = { format: 'shapio-richtext'; version: 1; doc?: RichTextNode; html?: string };

export type MediaAsset = {
  id: string;
  filename: string;
  mimeType: string;
  sizeBytes: number;
  width: number | null;
  height: number | null;
  alt: string;
  caption: string;
  focalPoint: { x: number; y: number } | null;
  /** Stable for public assets; signed and expiring for private ones. */
  url: string;
  urlExpiresAt: string | null;
  variants: Array<{ name: string; width: number | null; height: number | null; format: string; mimeType: string; url: string }>;
};

/** A relation value: the target entry's ID, or the entry itself when populated. */
export type Related<T> = string | T;

export type EntrySystemFields = {
  id: string;
  locale: string;
  createdAt: string;
  updatedAt: string;
  publishedAt: string;
};

// Schema version 5

/** About: every field (singleton \`about\`) */
export type AboutFields = EntrySystemFields & {
  /** Title */
  title: string | null;
  /** Summary */
  summary: string | null;
};

/** About (singleton \`about\`) */
export type About = AboutFields & { __model: "about"; __kinds: readonly ["about"] };

/** About, as written (singleton \`about\`) */
export type AboutInput = {
  /** Title */
  title?: string | null;
  /** Summary */
  summary?: string | null;
};

/** Featurable: what every member has (interface \`featurable\`, delivery route \`featurables\`) */
export type Featurable = EntrySystemFields & {
  /** Title */
  title: string | null;
  /** Summary */
  summary: string | null;
} & { __model: string; __kinds: readonly string[] };

/** Any Featurable (interface \`featurable\`, delivery route \`featurables\`): what its list, its entries' route and relations to it return. */
export type FeaturableAny = About | Guide | Post;

/** Guide: every field (collection \`guide\`, delivery route \`posts/guides\`, extends \`post\`) */
export type GuideFields = PostFields & {
  /** Level */
  level: number | null;
};

/** Guide (collection \`guide\`, delivery route \`posts/guides\`, extends \`post\`) */
export type Guide = GuideFields & { __model: "guide"; __kinds: readonly ["post", "guide"] };

/** Guide, as written (collection \`guide\`, delivery route \`posts/guides\`, extends \`post\`) */
export type GuideInput = PostInput & {
  /** Level */
  level?: number | null;
};

/** Homepage: every field (singleton \`homepage\`) */
export type HomepageFields = EntrySystemFields & {
  /** Featured */
  featured: Array<Related<FeaturableAny>> | null;
  /** Spotlight */
  spotlight: Related<AnyEntry> | null;
};

/** Homepage (singleton \`homepage\`) */
export type Homepage = HomepageFields & { __model: "homepage"; __kinds: readonly ["homepage"] };

/** Homepage, as written (singleton \`homepage\`) */
export type HomepageInput = {
  /** Featured */
  featured?: Array<string> | null;
  /** Spotlight */
  spotlight?: string | null;
};

/** Post: every field (collection \`post\`, delivery route \`posts\`) */
export type PostFields = EntrySystemFields & {
  /** Title */
  title: string | null;
  /** Summary */
  summary: string | null;
};

/** Post (collection \`post\`, delivery route \`posts\`) */
export type Post = PostFields & { __model: "post"; __kinds: readonly ["post"] };

/** Post, as written (collection \`post\`, delivery route \`posts\`) */
export type PostInput = {
  /** Title */
  title?: string | null;
  /** Summary */
  summary?: string | null;
};

/** Any kind of Post: what its list, its entries' route and relations to it return. */
export type PostAny = Post | Guide;

/** Any entry: what a relation to any entry holds. */
export type AnyEntry = About | Guide | Homepage | Post;

/** Delivery entry type by API ID (models and interfaces): what \`/api/content/:routeKey\` returns. */
export type ShapioModels = {
  about: About;
  guide: Guide;
  homepage: Homepage;
  post: PostAny;
  featurable: FeaturableAny;
};

/** Delivery route key (\`/api/content/:routeKey\`) by API ID (models and interfaces). */
export type ShapioRouteKeys = {
  about: 'about';
  guide: 'posts/guides';
  homepage: 'homepage';
  post: 'posts';
  featurable: 'featurables';
};
"
`;
