---
import Base from '../../../layouts/Base.astro';
import { isDev } from '../../../lib/config.js';
import { renderArticleCard } from '../../../lib/render.js';
import { renderTimeEntry } from '../../../lib/renderTime.js';
import { listArticles } from '../../../lib/shapio.js';
import { articlesPath, LOCALES, otherLocale, stringsFor, type Locale } from '../../../lib/site.js';
import type { Article } from '../../../lib/types.js';

export const getStaticPaths = async () =>
  Promise.all(
    LOCALES.map(async (locale) => ({ params: { locale }, props: { locale, articles: await listArticles(locale) } })),
  );

type Props = { locale: Locale; articles: Article[] };
const { locale } = Astro.props;
// In `astro dev`, read at render time (src/lib/renderTime.ts); a build renders the props above.
const articles =
  (await renderTimeEntry({ dev: isDev(), props: Astro.props.articles, read: () => listArticles(locale) })) ?? [];
const strings = stringsFor(locale);
const context = { locale, strings };
---

<Base title={strings.articles} locale={locale} alternatePath={articlesPath(otherLocale(locale))}>
  <h1 class="page-title">{strings.articles}</h1>
  <ul class="cards" set:html={articles.map((article) => renderArticleCard(article, context)).join('')} />
</Base>
