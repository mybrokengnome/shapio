{
  "name": "example-next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js (App Router) starter: pages and articles from Shapio, statically generated at one pinned snapshot, EN + FR.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "seed": "node --env-file-if-exists=.env --import tsx ../shared/scripts/seed.ts --site-url http://localhost:3000 --revalidate-path /api/revalidate/",
    "smoke": "node --env-file-if-exists=.env --import tsx ../shared/scripts/smokeHttp.ts --url http://localhost:3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@shapio/client": "workspace:*",
    "@shapio/local": "workspace:*",
    "@shapio/visual": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
