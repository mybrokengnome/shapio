# Copy to .env, or let `npm run seed` write SHAPIO_URL and SHAPIO_DELIVERY_TOKEN for you.
SHAPIO_URL=http://localhost:4300
# A read-only delivery token (Shapio admin: Settings → API tokens, a delivery role).
SHAPIO_DELIVERY_TOKEN=
# Optional: build this publication snapshot instead of the latest one. The site then stays at it:
# /api/revalidate does nothing.
# SHAPIO_SNAPSHOT=42
# The signing secret of the Shapio webhook that calls /api/revalidate (`npm run seed` writes it).
SHAPIO_WEBHOOK_SECRET=
# Optional: the site key on a multi-site Shapio (default: the token's site, else the primary site).
# SHAPIO_SITE=marketing
# Next.js collects anonymous telemetry unless this is set; the npm scripts set it too.
NEXT_TELEMETRY_DISABLED=1
# Optional: the Shapio URL the browser calls for draft previews, when it differs from SHAPIO_URL.
# NEXT_PUBLIC_SHAPIO_URL=https://cms.example.com
# Optional: this site's public origin; pages then carry a canonical URL and og:url.
# SITE_URL=https://www.example.com
# Optional: read Shapio's delivery API in this server process instead of over HTTP (@shapio/local), from
# Shapio's own database. A read-only database role is enough. Previews still use SHAPIO_URL.
# SHAPIO_MODE=in-process
# DATABASE_URL=postgres://shapio_site:password@localhost:5432/shapio
